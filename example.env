# Kopioi tiedosto nimellä .env: Copy-Item example.env .env
# Täytä oma token ja tarvittaessa kanavatunnisteet. Älä julkaise .env-tiedostoa.
# Muut arvot vastaavat config.py:n oletuksia. Käynnistä botti uudelleen muutosten jälkeen.
# Totuusarvot: true/false (myös 1/0, yes/no ja on/off käyvät).

# Discord-botin token (pakollinen Discord-yhteyttä varten).
DISCORD_TOKEN=

# Palvelimen kohdekanava ja JAA-komennon kohde. Tyhjä = ei kohdekanavaa.
TARGET_CHANNEL_ID=

# Indeksoitavat kanavat pilkuin eroteltuina.
# Oletuksena käytetään TARGET_CHANNEL_ID:tä, kun muuttuja on kommentoitu pois.
# Poista kommenttimerkki ja jätä arvo tyhjäksi poistaaksesi indeksoinnin käytöstä.
# ATTACHMENT_INDEX_CHANNEL_IDS=

# Kuvakopioiden samankaltaisuusraja prosentteina (0–100).
REPOST_WARNING_THRESHOLD=90

# Tilaviestien poistoviive sekunteina ja tilaviestien käyttö Discordissa.
STATUS_DELETE_DELAY=3
STATUS_LOG_MODE=true

# Käyttäjäviestien oletussäilytys päivinä ja siivousväli sekunteina.
MESSAGE_RETENTION_DAYS=30
CLEANUP_INTERVAL=300

# Ajastamattomien botin kanavaviestien siivous: off / preview / delete.
# preview listaa ehdokkaat lokiin. delete poistaa säilytysajan ylittäneet viestit.
UNTRACKED_BOT_MESSAGE_CLEANUP_MODE=preview
UNTRACKED_BOT_MESSAGE_RETENTION_HOURS=24
# Tyhjä = käytä TARGET_CHANNEL_ID:tä.
UNTRACKED_BOT_MESSAGE_CHANNEL_ID=

# Ollama-vastaukset botin suoriin mainintoihin.
ENABLE_OLLAMA=false
# Montako saman keskustelun aiempaa viestiä tarkistetaan. 0 = ei taustahistoriaa.
OLLAMA_RECENT_MESSAGES=12
# Vianetsintä. Tallentaa Ollama-keskustelun tekstejä paikalliseen JSONL-lokiin.
OLLAMA_TRACE_ENABLED=false
OLLAMA_HOSTS=http://192.168.1.11:11434,http://192.168.1.12:11434,http://192.168.1.13:11434
# Pilkulla erotetut mallinimet. Etuliite ! ohittaa mallin kaikilla palvelimilla.
# Tyhjä arvo tai pelkät poissulut käyttävät automaattista mallihakua.
# Esimerkki: OLLAMA_MODELS=!qwen3:4b
OLLAMA_MODELS=
# Tarkat mallinimet halutussa järjestyksessä. !malli sulkee mallin pois kyseisestä
# pyyntötyypistä myös automaattihaussa. Tyhjä = tavallinen mallihaku.
OLLAMA_CHAT_PRIORITY=
OLLAMA_VISION_PRIORITY=
# Aikarajat sekunteina: chat-yhteys, mallilista, yksi chat-pyyntö ja koko kierros.
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_DISCOVERY_TIMEOUT_SECONDS=5
OLLAMA_MODEL_TIMEOUT_SECONDS=40
OLLAMA_TOTAL_TIMEOUT_SECONDS=120
# Valinnainen UTF-8-ohjetiedosto. Suhteellinen polku alkaa projektikansiosta.
# OLLAMA_INSTRUCTIONS_FILE=instructions/local.md
# Oletus on TARGET_CHANNEL_ID. Tyhjä arvo sallii vain yksityisviestit.
# OLLAMA_CHANNEL_IDS=

# Median latauspalvelut.
ENABLE_YOUTUBE=true
ENABLE_INSTAGRAM=true
ENABLE_X=true
ENABLE_TIKTOK=true
ENABLE_TWITCH=true
ENABLE_SOUNDCLOUD=true
# false = SoundCloud lähetetään MP3-tiedostona Discordissa.
ENABLE_SOUNDCLOUD_VIDEO=true

# Videon automaattinen pakkaus ja pakkauksen tavoitekoko megatavuina.
ENABLE_VIDEO_COMPRESS=true
VIDEO_COMPRESS_TARGET_MB=9.2

# Kuvien tulostus ja hyväksytyt tulostusreaktiot pilkuin eroteltuina.
ENABLE_IMAGE_PRINTING=true
PRINT_EMOJIS=🖨️,✅
# Tulostusreaktion odotusaika sekunteina.
PRINT_TIMEOUT=300

# GUI:n SoundCloud-videoasetukset ja äänimerkit tallentuvat QSettings-asetuksiin,
# eivät ympäristömuuttujiin. Tulostimen nimi määritetään config.py-tiedostossa.
# PYTHONIOENCODING asetetaan GUI:n latausprosessille automaattisesti arvoon utf-8.
